# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Not used by the app at runtime (all writes go through the
# admin's session + RLS), but keep it handy for scripts / Supabase CLI.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but recommended: lock the admin panel to this one email address,
# even if another account somehow exists in Supabase Auth.
ADMIN_EMAIL=
